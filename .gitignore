# Secrets — never commit
.env
.env.*
!.env.example

# Python
.venv/
.venv-ml/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# ML artifacts (large; keep out of git)
ml/**/runs/
ml/**/datasets/
ml/**/*.pt
ml/**/*.onnx
ml/**/*.mlpackage

# iOS / Xcode
ios/*.xcodeproj/
ios/build/
DerivedData/
*.xcuserstate
xcuserdata/

# OS / editors
.DS_Store
.idea/
.vscode/

# Generated eval output (re-created by ml/eval tests)
ml/eval/results/

# Generated by xcodegen from ios/project.yml (info.properties); never edit by hand
ios/App/Info.plist

# Pipeline data (datasets, receipts, outputs; large / private) - see docs/PIPELINE.md
pipeline/data/*
!pipeline/data/.gitkeep

# Per-developer signing config
ios/Local.xcconfig

# Swift packages cloned by CI-style builds (-clonedSourcePackagesDirPath)
ios/.spm/
ios/DD/
